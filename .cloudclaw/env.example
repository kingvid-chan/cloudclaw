# Copy to `.cloudclaw/env.local` on a host that needs non-default paths.
# `start.sh` loads env.local before invoking docker compose.

# Private Cloud state repo.
# Local default: ../cloudclaw-private/.cloudclaw
# Production example: /opt/cloudclaw-private/.cloudclaw
CLOUDCLAW_PRIVATE_DIR=

# Host directory exposed read-only to Cloud for life-system context.
# Local default: parent directory of Agentic Cowork.
# Production example: /srv/life-system
CLOUDCLAW_LIFE_SYSTEM_DIR=

# Container mount point for CLOUDCLAW_LIFE_SYSTEM_DIR.
# Keep this stable unless private AGENTS.md/HEARTBEAT.md are updated too.
CLOUDCLAW_LIFE_SYSTEM_MOUNT=/home/node/.openclaw/workspace/人生系统

# Host install directory of @google/gemini-cli.
# Local default: auto-detect via `npm root -g`, then common nvm fallback.
# Production example: /opt/gemini-cli-node_modules/@google/gemini-cli
CLOUDCLAW_GEMINI_CLI_DIR=

# Host Gemini CLI OAuth/config directory mounted to /home/node/.gemini.
# Local default: ~/.gemini
CLOUDCLAW_GEMINI_HOME_DIR=

# Host path to the public wrapper mounted as /usr/local/bin/gemini.
# Local default: .cloudclaw/gemini-wrapper.sh
CLOUDCLAW_WRAPPER_PATH=

# Default approval is auto_edit. Use yolo only for explicit maintenance runs.
CLOUDCLAW_GEMINI_APPROVAL_MODE=auto_edit
